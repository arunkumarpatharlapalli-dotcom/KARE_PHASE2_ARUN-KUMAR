//write a java prg to find the odd even element count in the given array
//i/p                         o/p 
//5
//10 2 34 5 23              odd element count:2
//                          even elemnt count:3 
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int arr[]=new int[n];
        int i,ec=0,oc=0;
        for(i=0;i<n;i++) {
            arr[i]=obj.nextInt();
            if(arr[i]%2==0)
            ec++;
            else
            oc++;
        }
        System.out.println("odd element count: "+oc);
        System.out.println("even element count: "+ec);
    }
}

