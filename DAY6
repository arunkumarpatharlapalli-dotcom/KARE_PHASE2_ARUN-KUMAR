//Strong Number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n;
        int fact,sum=0,d;
        while(n!=0) {
            fact = 1;
            d = n%10;
            for(int i =1;i<=d;i++)
            fact=fact*i;
            sum=sum+fact;
            n=n/10;
        } 
        if(temp==sum)
        System.out.println("Strong Number");
        else 
        System.out.println("Not a Strong Number");
    }
}   

//armstrong Number
//step1 get the input from user n = 153
//step2 count the no of digits count=15
//3 segregate each digit & make the power value as per count value 1^3 = 1 5^3 = 125 3^3 = 27
//4 find the sum of all power values 1+125+27=153
//5 if sum==given number print Armstrong number
//Math.pow(basevalue,powervalue)
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n,c=0,d,sum=0;
        while(n!=0) {
            n=n/10;
            c++;
        } 
        n = temp;
        while(n!=0) {
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.println("Armstrong Number");
        else 
        System.out.println("Not a Armstrong Number");
    }
}   
